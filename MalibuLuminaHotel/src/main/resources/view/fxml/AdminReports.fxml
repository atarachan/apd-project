<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.senecacollege.malibuluminahotel.controller.AdminReportsController"
            prefWidth="1280"
            prefHeight="800"
            stylesheets="@../css/style.css">

    <top>
        <VBox alignment="CENTER" spacing="8">
            <padding><Insets top="20" bottom="14"/></padding>
            <Label text="Reports" styleClass="title-label"/>
            <Label text="Generate and export reports" styleClass="subtitle-label"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" alignment="TOP_CENTER" styleClass="option-card">
            <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

            <!-- Report Controls -->
            <VBox spacing="14" styleClass="form-card" prefWidth="800">
                <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>
                <Label text="Report Configuration" styleClass="section-label"/>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <VBox spacing="6">
                        <Label text="Report Type" styleClass="field-label"/>
                        <ComboBox fx:id="reportTypeComboBox" prefWidth="200"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Start Date" styleClass="field-label"/>
                        <DatePicker fx:id="startDatePicker" prefWidth="150"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="End Date" styleClass="field-label"/>
                        <DatePicker fx:id="endDatePicker" prefWidth="150"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text=" " styleClass="field-label"/>
                        <Button fx:id="generateButton" text="Generate Report" 
                                prefWidth="150" prefHeight="35"
                                styleClass="primary-button"
                                onAction="#handleGenerateReport"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Report Table -->
            <VBox spacing="10" styleClass="form-card" prefWidth="800" prefHeight="300">
                <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>
                <Label text="Report Data" styleClass="section-label"/>
                <TableView fx:id="reportTableView" prefHeight="220"/>
            </VBox>

            <!-- Summary and Export -->
            <HBox spacing="20" alignment="TOP_CENTER">
                <!-- Summary -->
                <VBox spacing="10" styleClass="form-card" prefWidth="400" prefHeight="180">
                    <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>
                    <Label text="Summary" styleClass="section-label"/>
                    <TextArea fx:id="summaryTextArea" prefHeight="100" editable="false"/>
                </VBox>

                <!-- Export Buttons -->
                <VBox spacing="10" styleClass="form-card" prefWidth="360" prefHeight="180" alignment="CENTER">
                    <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>
                    <Label text="Export Options" styleClass="section-label"/>
                    <Button fx:id="exportCsvButton" text="Export to CSV" 
                            prefWidth="200" prefHeight="35"
                            styleClass="primary-button"
                            onAction="#handleExportCsv"/>
                    <Button fx:id="exportPdfButton" text="Export to PDF" 
                            prefWidth="200" prefHeight="35"
                            styleClass="primary-button"
                            onAction="#handleExportPdf"/>
                    <Button fx:id="exportTxtButton" text="Export Summary to TXT" 
                            prefWidth="200" prefHeight="35"
                            styleClass="primary-button"
                            onAction="#handleExportTxt"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding><Insets top="20" bottom="25"/></padding>
            <Button text="Back to Dashboard"
                    prefWidth="220" prefHeight="50"
                    styleClass="secondary-button"
                    onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>
