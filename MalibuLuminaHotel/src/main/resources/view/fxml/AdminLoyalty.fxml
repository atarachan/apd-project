<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.senecacollege.malibuluminahotel.controller.AdminLoyaltyController"
            prefWidth="1280"
            prefHeight="800"
            stylesheets="@../css/style.css">

    <top>
        <VBox alignment="CENTER" spacing="8">
            <padding><Insets top="20" bottom="14"/></padding>
            <Label text="Loyalty Program" styleClass="title-label"/>
            <Label text="Track and manage guest loyalty points" styleClass="subtitle-label"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" alignment="CENTER" styleClass="option-card">
            <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

            <VBox spacing="14" styleClass="form-card" prefWidth="860">
                <HBox alignment="CENTER_LEFT" spacing="16">

                    <Label text="Member Points Overview"
                           styleClass="section-label"/>

                    <Button text="+ Create Loyalty Account"
                            prefWidth="210"
                            prefHeight="36"
                            styleClass="primary-button"
                            onAction="#handleCreateAccount"/>

                </HBox>
                <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>

                <TableView fx:id="loyaltyTable"
                           prefWidth="850"
                           prefHeight="420">

                    <columns>

                        <TableColumn fx:id="memberNumberColumn"
                                     text="Member Number"
                                     prefWidth="160"/>

                        <TableColumn fx:id="guestNameColumn"
                                     text="Guest Name"
                                     prefWidth="200"/>

                        <TableColumn fx:id="emailColumn"
                                     text="Email"
                                     prefWidth="240"/>

                        <TableColumn fx:id="pointsColumn"
                                     text="Points"
                                     prefWidth="120"/>

                        <TableColumn fx:id="valueColumn"
                                     text="Value (CAD)"
                                     prefWidth="130"/>

                    </columns>

                </TableView>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding><Insets top="20" bottom="25"/></padding>
            <Button text="Back to Dashboard"
                    prefWidth="220" prefHeight="50"
                    styleClass="secondary-button"
                    onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>
