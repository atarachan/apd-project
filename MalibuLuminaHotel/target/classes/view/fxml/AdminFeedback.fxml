<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ComboBox?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.senecacollege.malibuluminahotel.controller.AdminFeedbackController"
            prefWidth="1280"
            prefHeight="800"
            stylesheets="@../css/style.css">

    <top>
        <VBox alignment="CENTER" spacing="8">
            <padding><Insets top="20" bottom="14"/></padding>
            <Label text="Guest Feedback" styleClass="title-label"/>
            <Label text="Review ratings and comments left by guests" styleClass="subtitle-label"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20"
              alignment="CENTER"
              styleClass="option-card">

            <padding>
                <Insets top="30"
                        right="40"
                        bottom="30"
                        left="40"/>
            </padding>

            <VBox spacing="15"
                  styleClass="form-card"
                  prefWidth="1050">

                <padding>
                    <Insets top="22"
                            right="28"
                            bottom="22"
                            left="28"/>
                </padding>

                <HBox spacing="20"
                      alignment="CENTER_LEFT">

                    <Label text="Average Rating:"
                           styleClass="field-label"/>

                    <Label fx:id="averageRatingLabel"
                           text="0.0 / 5.0"
                           styleClass="section-label"/>

                    <Label text="Minimum Rating:"
                           styleClass="field-label"/>

                    <ComboBox fx:id="minRatingFilter"
                              prefWidth="120"
                              onAction="#handleFilterByRating"/>

                </HBox>

                <TableView fx:id="feedbackTable"
                           prefHeight="500">

                    <columns>

                        <TableColumn fx:id="guestColumn"
                                     text="Guest"
                                     prefWidth="170"/>

                        <TableColumn fx:id="roomTypeColumn"
                                     text="Room Type"
                                     prefWidth="150"/>

                        <TableColumn fx:id="ratingColumn"
                                     text="Rating"
                                     prefWidth="90"/>

                        <TableColumn fx:id="commentColumn"
                                     text="Comment"
                                     prefWidth="470"/>

                        <TableColumn fx:id="dateColumn"
                                     text="Date"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding><Insets top="20" bottom="25"/></padding>
            <Button text="Back to Dashboard"
                    prefWidth="220" prefHeight="50"
                    styleClass="secondary-button"
                    onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>
