<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.senecacollege.malibuluminahotel.controller.GuestCheckoutController"
            prefWidth="1280"
            prefHeight="800"
            stylesheets="@../css/style.css">

    <top>
        <VBox alignment="CENTER" spacing="4">
            <padding>
                <Insets top="14" bottom="10"/>
            </padding>

            <Label text="Guest Checkout" styleClass="title-label"/>
            <Label text="Review your detailed bill before confirming" styleClass="subtitle-label"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="14">
            <padding>
                <Insets top="10" right="40" bottom="10" left="40"/>
            </padding>

            <VBox spacing="12" maxWidth="760" styleClass="form-card">
                <padding>
                    <Insets top="18" right="24" bottom="18" left="24"/>
                </padding>

                <Label text="Detailed Bill" styleClass="section-label"/>

                <ScrollPane fitToWidth="true"
                            prefHeight="360"
                            hbarPolicy="NEVER"
                            styleClass="form-card">
                    <content>
                        <VBox fx:id="billLinesBox" spacing="4">
                            <padding>
                                <Insets top="8" right="10" bottom="8" left="10"/>
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <VBox spacing="8">
                    <HBox spacing="10">
                        <Label text="Room charges:" prefWidth="560" styleClass="field-label"/>
                        <Label fx:id="roomChargesLabel" text="--" styleClass="field-label"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Add-ons:" prefWidth="560" styleClass="field-label"/>
                        <Label fx:id="addOnsLabel" text="--" styleClass="field-label"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Subtotal:" prefWidth="560" styleClass="field-label"/>
                        <Label fx:id="subtotalLabel" text="--" styleClass="field-label"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Taxes (13%):" prefWidth="560" styleClass="field-label"/>
                        <Label fx:id="taxLabel" text="--" styleClass="field-label"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Total Amount:" prefWidth="560" styleClass="section-label"/>
                        <Label fx:id="totalLabel" text="--" styleClass="section-label"/>
                    </HBox>
                </VBox>
            </VBox>

            <HBox spacing="16" alignment="CENTER">
                <Button text="Complete Booking"
                        prefWidth="220"
                        prefHeight="46"
                        styleClass="primary-button"
                        onAction="#handleProceedToPayment"/>

                <Button text="Cancel"
                        prefWidth="160"
                        prefHeight="46"
                        styleClass="secondary-button"
                        onAction="#handleCancel"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER">
            <padding>
                <Insets top="10" bottom="14"/>
            </padding>

            <Label text="Malibu Lumina Hotel" styleClass="footer-label"/>
        </VBox>
    </bottom>

</BorderPane>
